# Environment. Copy to .env only if you need to override something; normally nothing
# here needs setting, because every script and hook resolves the repo from its own
# location. .env is gitignored and never travels in the kit.
#
# A missing value never degrades a feature quietly: the check that needs it refuses
# and says which line is empty.

# --- where the repo lives ----------------------------------------------------
# Only set this if the repo is not where scripts/ resolves it from.
# EA_ROOT=C:\EA

# Only set this if `python` on PATH is not the interpreter the scheduled tick
# should use. The wrapper tries this first, then PATH.
# EA_PYTHON=C:\Program Files\Python312\python.exe

# --- the register ------------------------------------------------------------
# Override the database path. Normally state/ea.db, or state/fixtures.db when
# EA_FIXTURE_MODE=1. Leave unset.
# EA_DB=

# --- test isolation ------------------------------------------------------------
# EA_FIXTURE_MODE=1 points every script at state/fixtures.db, and makes
# scripts/docs_edit.py refuse any Doc not registered as a fixture. The acceptance
# harness sets it for every step. Never set it in a live session.
# EA_FIXTURE_MODE=1

# --- Google ---------------------------------------------------------------------
# The OAuth client JSON goes at state/google-client.json and the token Taylor's
# consent mints goes at state/google-token.json. Neither belongs in this file, and
# both are gitignored by name as well as by directory.
